PROJECT_NAME=CodeWithAnil
ENVIRONMENT=production
API_V1_STR=/api
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./codewithanil.db
CORS_ORIGINS=["https://codewithanil.vercel.app","http://localhost:3000","http://127.0.0.1:3000"]
INFERENCE_BACKEND=onnx_int8
ONNX_MODEL_PATH=ml/models/roberta_chatgpt_detector_int8.onnx
TOKENIZER_DIR=ml/models/tokenizer
HF_MODEL_NAME=Hello-SimpleAI/chatgpt-detector-roberta
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=15
PYTHONUNBUFFERED=1
PORT=10000
