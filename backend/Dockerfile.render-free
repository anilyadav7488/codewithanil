# Production Dockerfile for CodeWithAnil Backend on 512 MB RAM Budget
# Multi-stage build with zero PyTorch footprint

FROM python:3.11-slim as builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev && rm -rf /var/lib/apt/lists/*

COPY requirements-render-free.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements-render-free.txt

# Final runtime image
FROM python:3.11-slim

WORKDIR /app

# Install runtime libpq for PostgreSQL
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 curl && rm -rf /var/lib/apt/lists/*

# Copy installed wheels from builder
COPY --from=builder /install /usr/local

# Copy backend application source
COPY . /app

# Ensure model assets are pre-downloaded in image build layer
RUN python ml/download_model.py

# Environment configuration
ENV PYTHONUNBUFFERED=1 \
    INFERENCE_BACKEND=onnx_int8 \
    ENVIRONMENT=production \
    PORT=10000

EXPOSE 10000

# Single worker avoids duplicating model in RAM on 512 MB instances
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
