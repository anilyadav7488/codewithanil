# CodeWithAnil Production Environment Configuration for Oracle Cloud ARM64
# Save as /opt/codewithanil/backend/.env with chmod 600

PROJECT_NAME=CodeWithAnil
ENVIRONMENT=production
API_V1_STR=/api

# Security: Generate with `openssl rand -hex 32` or `python3 -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=replace_with_a_secure_random_hex_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: Local PostgreSQL running on the same Oracle VM
DATABASE_URL=postgresql://codewithanil_user:CHANGE_ME_TO_STRONG_PASSWORD@127.0.0.1:5432/codewithanil

# CORS: Whitelist your deployed Vercel frontend URL
CORS_ORIGINS=["https://codewithanil.vercel.app","https://codewithanil-git-main-anilyadav7488s-projects.vercel.app"]

# Machine Learning Settings
HF_MODEL_NAME=Hello-SimpleAI/chatgpt-detector-roberta
INFERENCE_DEVICE=cpu
MAX_SEQUENCE_LENGTH=512
INCONCLUSIVE_LOWER_THRESHOLD=0.40
INCONCLUSIVE_UPPER_THRESHOLD=0.60

# Rate Limiting & Uploads
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=15
